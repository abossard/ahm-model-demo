{
  "name": "@playground/views",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && for v in hello lab checkers trader blackjack; do VIEW=$v vite build || exit 1; done",
    "dev": "VIEW=${VIEW:-hello} vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
