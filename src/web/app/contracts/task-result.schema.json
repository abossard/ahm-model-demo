{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskResult",
  "description": "What the agent passes to submit_result. An explain result traces a health state to its causes; a diff result proposes changes to a health model. Builder analysis describes selected resources, and builder proposals arrange confirmed resources into alternative models.",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": { "enum": ["explain", "diff", "builderAnalysis", "builderProposals"] }
  },
  "allOf": [
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "explain" } } },
      "then": { "$ref": "#/$defs/explain" }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "diff" } } },
      "then": { "$ref": "#/$defs/diff" }
    },
    {
      "if": { "properties": { "kind": { "const": "builderAnalysis" } } },
      "then": { "$ref": "#/$defs/builderAnalysis" }
    },
    {
      "if": { "properties": { "kind": { "const": "builderProposals" } } },
      "then": { "$ref": "#/$defs/builderProposals" }
    }
  ],
  "$defs": {
    "showMeHandles": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "description", "idDescription"],
        "properties": {
          "name": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "description": { "type": "string", "maxLength": 256, "pattern": "\\S" },
          "idDescription": { "type": "string", "maxLength": 256 }
        }
      }
    },
    "showMeAction": {
      "type": "object", "additionalProperties": false, "required": ["handle"],
      "properties": {
        "handle": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "id": { "type": "string", "maxLength": 256, "pattern": "\\S" },
        "highlight": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "color": { "type": "string", "enum": ["blue", "amber", "violet"] },
            "label": { "type": "string", "maxLength": 120, "pattern": "\\S" }
          }
        }
      }
    },
    "showMe": {
      "type": "object", "maxProperties": 16, "propertyNames": { "pattern": "^([1-9]|1[0-6])$" },
      "additionalProperties": { "$ref": "#/$defs/showMeAction" }
    },
    "builderText": { "type": "string", "minLength": 1, "maxLength": 800, "pattern": "\\S" },
    "builderLabel": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "builderResourceId": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "builderRow": {
      "type": "object", "additionalProperties": false,
      "required": ["resourceId", "displayName", "purpose", "impact"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/builderResourceId" },
        "displayName": { "$ref": "#/$defs/builderLabel" },
        "purpose": { "$ref": "#/$defs/builderText" },
        "impact": { "enum": ["Standard", "Limited", "Suppressed"] }
      }
    },
    "builderPlan": {
      "type": "object", "additionalProperties": false, "required": ["objective", "flows", "gaps"],
      "properties": {
        "objective": { "$ref": "#/$defs/builderText" },
        "decisions": { "type": "array", "minItems": 1, "maxItems": 12, "items": {
          "type": "object", "additionalProperties": false, "required": ["choice", "reason", "basis", "resourceIds"],
          "properties": {
            "choice": { "$ref": "#/$defs/builderLabel" }, "reason": { "$ref": "#/$defs/builderText" },
            "basis": { "enum": ["inventory", "measurement", "assumption", "userInput"] },
            "resourceIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
                             "items": { "$ref": "#/$defs/builderResourceId" } }
          }
        } },
        "flows": { "type": "array", "minItems": 1, "maxItems": 12, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "objective", "components", "failureScenario"],
          "properties": {
            "name": { "$ref": "#/$defs/builderLabel" }, "objective": { "$ref": "#/$defs/builderText" },
            "failureScenario": { "$ref": "#/$defs/builderText" },
            "components": { "type": "array", "minItems": 1, "maxItems": 32, "items": {
              "type": "object", "additionalProperties": false, "required": ["name", "resourceIds", "signal"],
              "properties": {
                "name": { "$ref": "#/$defs/builderLabel" }, "signal": { "$ref": "#/$defs/builderText" },
                "resourceIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
                                 "items": { "$ref": "#/$defs/builderResourceId" } }
              }
            } }
          }
        } },
        "gaps": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/builderText" } }
      }
    },
    "builderAnalysis": {
      "type": "object", "additionalProperties": false, "required": ["kind", "summary", "rows", "plan", "metrics"],
      "properties": {
        "kind": { "const": "builderAnalysis" },
        "showMe": { "$ref": "#/$defs/showMe" },
        "plan": { "$ref": "#/$defs/builderPlan" },
        "metrics": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/builderMetric" } },
        "omittedMetrics": { "type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["resourceId", "reason"],
          "properties": { "resourceId": { "$ref": "#/$defs/builderResourceId" }, "reason": { "$ref": "#/$defs/builderText" } }
        } },
        "summary": { "$ref": "#/$defs/builderText" },
        "rows": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/builderRow" } }
      }
    },
    "builderGroup": {
      "type": "object", "additionalProperties": false, "required": ["name", "purpose", "resourceIds"],
      "properties": {
        "name": { "$ref": "#/$defs/builderLabel" },
        "purpose": { "$ref": "#/$defs/builderText" },
        "resourceIds": { "type": "array", "uniqueItems": true, "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/builderResourceId" } }
      }
    },
    "builderProposal": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "tradeoff", "structure", "groups"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "title": { "$ref": "#/$defs/builderLabel" },
        "summary": { "$ref": "#/$defs/builderText" },
        "tradeoff": { "$ref": "#/$defs/builderText" },
        "structure": { "enum": ["planned", "direct", "grouped"] },
        "groups": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/builderGroup" } }
      }
    },
    "builderMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["resourceId", "metricName", "metricNamespace", "aggregation", "operator", "threshold", "sample"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/builderResourceId" },
        "metricName": { "$ref": "#/$defs/builderLabel" },
        "metricNamespace": { "$ref": "#/$defs/builderLabel" },
        "aggregation": { "enum": ["Average", "Maximum", "Minimum", "Total", "Count"] },
        "operator": { "enum": ["GreaterThan", "LessThan"] },
        "threshold": { "type": "number" },
        "sample": { "type": "number" }
      }
    },
    "builderProposals": {
      "type": "object", "additionalProperties": false, "required": ["kind", "proposals"],
      "properties": {
        "kind": { "const": "builderProposals" },
        "showMe": { "$ref": "#/$defs/showMe" },
        "proposals": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/builderProposal" } },
        "metrics": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/builderMetric" } }
      }
    },
    "text": { "type": "string", "minLength": 1 },
    "nullableText": { "type": ["string", "null"], "minLength": 1 },
    "reading": { "type": ["string", "number", "null"] },
    "healthState": { "enum": ["Healthy", "Degraded", "Unhealthy", "Unknown"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" }
      }
    },
    "armName": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{1,258}[a-zA-Z0-9]$" },
    "explain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entity", "state", "summary", "causes"],
      "properties": {
        "kind": { "const": "explain" },
        "showMe": { "$ref": "#/$defs/showMe" },
        "entity": { "$ref": "#/$defs/text" },
        "state": { "$ref": "#/$defs/healthState" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "window": { "$ref": "#/$defs/window" },
        "summary": { "$ref": "#/$defs/text" },
        "causes": { "type": "array", "items": { "$ref": "#/$defs/cause" } }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "signal", "state", "threshold", "value", "rollup", "note"],
      "properties": {
        "entity": { "$ref": "#/$defs/text" },
        "signal": { "$ref": "#/$defs/nullableText" },
        "state": { "$ref": "#/$defs/healthState" },
        "threshold": { "$ref": "#/$defs/nullableText" },
        "value": { "$ref": "#/$defs/reading" },
        "rollup": { "$ref": "#/$defs/nullableText" },
        "note": { "$ref": "#/$defs/text" }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "changes", "verification", "findings"],
      "properties": {
        "kind": { "const": "diff" },
        "showMe": { "$ref": "#/$defs/showMe" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "summary": { "$ref": "#/$defs/text" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "kind", "name", "after", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "op": { "enum": ["add", "change", "remove"] },
        "kind": { "enum": ["entity", "signalDefinition", "relationship"] },
        "name": { "$ref": "#/$defs/armName" },
        "after": { "type": ["object", "null"] },
        "reason": { "$ref": "#/$defs/text" }
      },
      "if": { "required": ["op"], "properties": { "op": { "const": "remove" } } },
      "then": { "properties": { "after": { "type": "null" } } },
      "else": { "properties": { "after": { "type": "object" } } }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "signal", "status", "query", "value", "error"],
      "properties": {
        "entity": { "$ref": "#/$defs/text" },
        "signal": { "$ref": "#/$defs/text" },
        "status": { "enum": ["verified", "failing", "not_run"] },
        "query": { "$ref": "#/$defs/nullableText" },
        "value": { "$ref": "#/$defs/reading" },
        "error": { "$ref": "#/$defs/nullableText" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "entity", "text", "changeIds"],
      "properties": {
        "severity": { "enum": ["high", "medium", "low"] },
        "entity": { "$ref": "#/$defs/nullableText" },
        "text": { "$ref": "#/$defs/text" },
        "changeIds": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    }
  }
}
