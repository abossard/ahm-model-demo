{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "modelDeploymentCapacity": {
      "value": "${AZURE_MODEL_CAPACITY:-500}"
    },
    "webImage": {
      "value": "${SERVICE_WEB_IMAGE_NAME}"
    },
    "mcpImage": {
      "value": "${SERVICE_MCP_IMAGE_NAME}"
    },
    "entraAllowAzureCli": {
      "value": "${ENTRA_ALLOW_AZURE_CLI:-false}"
    },
    "entraAllowedTenants": {
      "value": "${ENTRA_ALLOWED_TENANTS}"
    },
    "foundryAgentPrincipalId": {
      "value": "${FOUNDRY_AGENT_PRINCIPAL_ID}"
    }
  }
}
